# Raw dataset - download instructions are in README.md instead of committing this
/data/*
!/data/.gitkeep

# Local-only scratch space, never pushed
/local/
/deletable/
/checklist
# Derived/regeneratable result cache (unlike results/*.png,
# which WRITEUP.md embeds directly)
/results/*.pkl

# Python environment / cache
/venv/
__pycache__/
*.pyc

# OS / editor cruft
.DS_Store
.vscode/
*.swp
*.swo
.ipynb_checkpoints/

# Packaging build output
*.egg-info/
build/
dist/
